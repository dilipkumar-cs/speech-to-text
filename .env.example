# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# PostgreSQL (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=speech_to_text
DB_USER=postgres
DB_PASSWORD=postgres

# Optional
# GEMINI_MODEL=models/gemini-3.5-transcribe-live
# GEMINI_LANGUAGE_CODES=          # empty = auto-detect incl. Hindi/English code-switching; or e.g. hi-IN,en-IN
# GEMINI_MODE=VERBATIM            # or SMART
# GEMINI_CUSTOM_VOCABULARY=       # comma separated domain words
# ALLOWED_ORIGINS=http://localhost:5173
